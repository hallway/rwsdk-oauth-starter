// Streamlined Prisma schema focused on auth essentials

generator client {
  provider               = "prisma-client"
  runtime                = "workerd"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  output                 = "../generated/prisma"
  previewFeatures        = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Core User model with essential auth fields

model User {
  id               String       @id @default(uuid())
  //username      String    @unique
  name             String
  username         String?      @unique
  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  // Auth relationships
  sessions         Session[]
  accounts         Account[]
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?
  twofactors       TwoFactor[]
  members          Member[]
  invitations      Invitation[]
  chatMessages     ChatMessage[]
  openAIThreads    OpenAIThread[]
  apiKeys          ApiKey[]
  spaceMemberships SpaceMember[]
  spaces           Space[]        @relation("SpaceOwner")

  @@map("user")
}

// Session management for secure auth

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy       String?
  activeOrganizationId String?

  @@map("session")
}

// OAuth/External provider accounts

model Account {
  id                    String    @id @default(uuid())
  accountId             String // Provider's user ID
  providerId            String // e.g., "google", "github"
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // For email/password auth
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  // One account per provider per external user
  @@unique([providerId, accountId])
  @@map("account")
}

// Email verification, password reset, etc.

model Verification {
  id         String   @id @default(uuid())
  identifier String // email, phone, etc.
  value      String // verification code/token
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // Prevent duplicate codes
  @@unique([identifier, value])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Organization {
  id          String       @id
  name        String
  slug        String?
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model ApiKey {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  key       String    @unique @map("apiKey")

  @@map("apiKey")
}

model Space {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt
  ownerId   String
  owner     User                 @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String               @unique
  color     String?
  members   SpaceMember[]
  objects   Object[]

  @@index([ownerId])
  @@map("space")
}

enum SpaceMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model SpaceMember {
  id             String       @id @default(uuid())
  space          Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId        String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           SpaceMemberRole @default(MEMBER)
  joinedAt       DateTime     @default(now())

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId])
  @@map("spaceMember")
}

enum ObjectType {
  FOLDER
  OBJECT
}

model Object {
  id               String        @id @default(uuid())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  name             String        @default("New object")
  description      String?
  space            Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId          String
  icon             String?
  order            Int           @default(0)
  
  // Hierarchical structure
  parent           Object?       @relation("ObjectHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  parentId         String?
  children         Object[]      @relation("ObjectHierarchy")
  
  // Self-definition
  objectSchema     String        @default("{}") // JSON schema defining the object's structure and capabilities
  data             String        @default("{}") // JSON data following the objectSchema
  
  // DATABASE CONFIGURATION
  hasDatabase      Boolean       @default(false)
  tursoUrl         String?       // Turso database URL
  tursoToken       String?       // Encrypted Turso auth token
  
  // EXECUTION CONFIGURATION
  hasUI            Boolean       @default(true)  // false for code-only objects
  entryPoint       String?       // e.g., "index.ts", "main.js"
  
  // HOSTING CONFIGURATION
  hostUrl          String?       // e.g., "https://esm.town/v/myspace/my-object?v=6"
  currentVersion   Int           @default(1)
  isPublished      Boolean       @default(false)
  
  // Relationships
  branches         Branch[]
  snapshots        Snapshot[]
  tags             ObjectTag[]
  permissions      ObjectPermission[]

  @@unique([spaceId, name, parentId])
  @@index([spaceId])
  @@index([parentId])
  @@index([hasDatabase])
  @@index([isPublished])
  @@map("object")
}

model Branch {
  id           String     @id @default(uuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  name         String
  object       Object     @relation(fields: [objectId], references: [id], onDelete: Cascade)
  objectId     String
  
  // Current state of this branch (HEAD)
  headSnapshot    Snapshot? @relation("BranchHead", fields: [headSnapshotId], references: [id])
  headSnapshotId  String?   @unique
  
  // Branch metadata
  isDefault    Boolean    @default(false)
  isProtected  Boolean    @default(false)
  
  snapshots    Snapshot[] @relation("SnapshotBranch")

  @@unique([objectId, name])
  @@index([objectId])
  @@map("branch")
}

model Snapshot {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  message     String?
  
  // Relationships
  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  objectId    String
  branch      Branch   @relation("SnapshotBranch", fields: [branchId], references: [id], onDelete: Cascade)
  branchId    String
  
  // Branch head relationship
  branchHead  Branch?  @relation("BranchHead")
  
  // Multi-file support
  files       File[]
  
  @@index([objectId])
  @@index([branchId])
  @@map("snapshot")
}

model File {
  id          String    @id @default(uuid())
  
  // File metadata
  path        String    // relative path like "src/index.js" or "README.md"
  content     String    // file contents
  size        Int       // file size in bytes
  mimeType    String?   // e.g., "application/javascript", "text/markdown"
  
  // Relationships
  snapshot    Snapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  snapshotId  String

  @@unique([snapshotId, path]) // One file per path per snapshot
  @@index([snapshotId])
  @@index([path])
  @@map("file")
}

model ObjectTag {
  id       String @id @default(uuid())
  name     String
  object   Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  objectId String

  @@unique([objectId, name])
  @@index([objectId])
  @@map("objectTag")
}

model ObjectPermission {
  id       String @id @default(uuid())
  object   Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  objectId String
  userId   String
  role     String

  @@unique([objectId, userId])
  @@index([objectId])
  @@index([userId])
  @@map("objectPermission")
}

model ChatMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  content   String
  role      String // "user" or "assistant"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String?
  thread    OpenAIThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([threadId])
  @@map("chatMessage")
}

model OpenAIThread {
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  threadId     String        @unique // OpenAI thread ID
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([userId])
  @@map("openAIThread")
}
